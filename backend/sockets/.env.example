# --- Redis Cache & Pub/Sub ---
# Используется для хранения онлайн-статусов и связи реплик socket.io
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ Message Broker ---
# Используется для получения событий от rest_api (FastStream)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Security (JWT Validation) ---
# Публичный RSA ключ в формате Base64 (без переносов строк).
# Оставьте пустым, если используете чтение из файла certs/public.pem
JWT_PUBLIC_KEY_B64=
